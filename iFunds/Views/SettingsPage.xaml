<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="iFunds.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="20,52,20,16">
        <StackPanel Spacing="14">
            <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" />

            <!-- 刷新 -->
            <Border CornerRadius="12" Padding="16"
                    Background="{StaticResource LinearSurface}"
                    BorderBrush="{StaticResource LinearBorder}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="刷新" FontSize="14" FontWeight="SemiBold" Opacity="0.8" />
                    <Grid>
                        <TextBlock Text="自动刷新" VerticalAlignment="Center" />
                        <ToggleSwitch IsOn="{x:Bind Settings.AutoRefresh, Mode=TwoWay}"
                                      HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="刷新间隔" />
                            <TextBlock Text="单位：秒" FontSize="11" Opacity="0.5" />
                        </StackPanel>
                        <NumberBox Value="{x:Bind Settings.RefreshIntervalSeconds, Mode=TwoWay}"
                                   Minimum="10" Maximum="600" SpinButtonPlacementMode="Inline"
                                   SmallChange="10" Width="140" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 通知 -->
            <Border CornerRadius="12" Padding="16"
                    Background="{StaticResource LinearSurface}"
                    BorderBrush="{StaticResource LinearBorder}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="通知" FontSize="14" FontWeight="SemiBold" Opacity="0.8" />
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="涨跌幅提醒通知" />
                            <TextBlock Text="命中提醒规则时弹出系统通知" FontSize="11" Opacity="0.5" />
                        </StackPanel>
                        <ToggleSwitch IsOn="{x:Bind Settings.EnableAlertNotifications, Mode=TwoWay}"
                                      HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 行为 -->
            <Border CornerRadius="12" Padding="16"
                    Background="{StaticResource LinearSurface}"
                    BorderBrush="{StaticResource LinearBorder}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="行为" FontSize="14" FontWeight="SemiBold" Opacity="0.8" />
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="关闭时最小化到托盘" />
                            <TextBlock Text="关闭则点 X 直接退出" FontSize="11" Opacity="0.5" />
                        </StackPanel>
                        <ToggleSwitch IsOn="{x:Bind Settings.MinimizeToTrayOnClose, Mode=TwoWay}"
                                      HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="开机自启" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="StartupToggle"
                                      Toggled="OnStartupToggled"
                                      HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 桌面小组件 -->
            <Border CornerRadius="12" Padding="16"
                    Background="{StaticResource LinearSurface}"
                    BorderBrush="{StaticResource LinearBorder}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="桌面小组件" FontSize="14" FontWeight="SemiBold" Opacity="0.8" />
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="显示桌面悬浮小组件" />
                            <TextBlock Text="实时曲线，置顶半透明，双击打开主窗口" FontSize="11" Opacity="0.5" />
                        </StackPanel>
                        <ToggleSwitch IsOn="{x:Bind Settings.ShowDesktopWidget, Mode=TwoWay}"
                                      Toggled="OnWidgetToggled"
                                      HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="16"
                    Background="{StaticResource LinearSurface}"
                    BorderBrush="{StaticResource LinearBorder}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="导入基金" FontSize="14" FontWeight="SemiBold" Opacity="0.8" />
                    <TextBlock Text="下载 JSON 模板，按样例填写基金代码、名称、持有份额、成本价、涨跌幅提醒，再选择文件导入。"
                               FontSize="11" Opacity="0.5" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Click="OnDownloadTemplate">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="下载模板" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnImportFile" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                <TextBlock Text="选择文件导入" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnExportBackup">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                <TextBlock Text="导出备份" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="iFunds v0.1 · 数据为模拟数据" FontSize="11" Opacity="0.4"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
