<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="iFunds.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource LinearBg}">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xE8D5;" FontSize="48" Foreground="{StaticResource LinearTextTertiary}"
                      HorizontalAlignment="Center" />
            <TextBlock x:Name="PageTitle" Text="即将上线" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource LinearTextSecondary}" HorizontalAlignment="Center" />
            <TextBlock Text="功能开发中，敬请期待" FontSize="13"
                       Foreground="{StaticResource LinearTextTertiary}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
