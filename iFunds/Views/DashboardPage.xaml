<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="iFunds.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:iFunds.Models"
    xmlns:ctl="using:iFunds.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource LinearBg}">

    <Grid Padding="24,48,24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="欢迎回来" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="以下是你的基金概览" FontSize="12" Opacity="0.5" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.5" Margin="0,0,8,0">
                    <Run Text="刷新于 " /><Run Text="{x:Bind ViewModel.RefreshTime, Mode=OneWay}" />
                </TextBlock>
                <Button Click="OnToggleHide" Width="38" Height="38" CornerRadius="10"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="隐藏/显示金额">
                    <FontIcon Glyph="{x:Bind ViewModel.EyeGlyph, Mode=OneWay}" FontSize="18" />
                </Button>
                <Button Click="OnRefreshClick" Width="38" Height="38" CornerRadius="10"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="刷新">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="今日收益" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.TodayRateText, Mode=OneWay}" FontSize="11"
                                   Foreground="{StaticResource LinearTextTertiary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.TotalProfitText, Mode=OneWay}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="持有金额" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.HoldRateText, Mode=OneWay}" FontSize="11"
                                   Foreground="{StaticResource LinearTextTertiary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.TotalAmountText, Mode=OneWay}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="关注数" FontSize="12" Opacity="0.55" />
                    <TextBlock Text="{x:Bind ViewModel.WatchCountText, Mode=OneWay}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="提醒数" FontSize="12" Opacity="0.55" />
                    <TextBlock Text="{x:Bind ViewModel.AlertCountText, Mode=OneWay}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SectionCard}">
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="收益热力图" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <RadioButton Content="日" GroupName="period" IsChecked="True" Style="{StaticResource PeriodToggle}" Checked="OnPeriodChanged" Tag="Day" />
                        <RadioButton Content="周" GroupName="period" Style="{StaticResource PeriodToggle}" Checked="OnPeriodChanged" Tag="Week" />
                        <RadioButton Content="月" GroupName="period" Style="{StaticResource PeriodToggle}" Checked="OnPeriodChanged" Tag="Month" />
                        <RadioButton Content="年" GroupName="period" Style="{StaticResource PeriodToggle}" Checked="OnPeriodChanged" Tag="Year" />
                    </StackPanel>
                </Grid>

                <ctl:HeatmapGrid x:Name="Heatmap"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Top" />

                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <TextBlock Text="跌" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                    <Border Width="13" Height="13" CornerRadius="2" Background="#2EAD6F" />
                    <Border Width="13" Height="13" CornerRadius="2" Background="#1E4A38" />
                    <Border Width="13" Height="13" CornerRadius="2" Background="#24262E" />
                    <Border Width="13" Height="13" CornerRadius="2" Background="#6E2A2E" />
                    <Border Width="13" Height="13" CornerRadius="2" Background="#E5484D" />
                    <TextBlock Text="涨" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Padding="18,18,18,8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="持有·关注" FontSize="14" FontWeight="SemiBold" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Enabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Funds, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Fund">
                                <Border Tapped="OnFundTapped" Tag="{x:Bind Code}"
                                        CornerRadius="10" Padding="14,11" Margin="0,3" BorderThickness="0"
                                        Background="{x:Bind RowBackground, Mode=OneWay}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                    <Border Background="#5E6AD2" CornerRadius="6" Padding="6,1" VerticalAlignment="Center"
                                                            Visibility="{x:Bind HoldingVisibility, Mode=OneWay}">
                                                        <TextBlock Text="持有" FontSize="10" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="11" Opacity="0.55">
                                                    <Run Text="{x:Bind Code}" /><Run Text="  ·  " /><Run Text="{x:Bind EstimateTime, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <ctl:Sparkline Grid.Column="1" Height="28" PointsSource="{x:Bind Trend}" IsUp="{x:Bind IsUp, Mode=OneWay}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind GrowthText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" MinWidth="62" TextAlignment="Right"
                                                       Foreground="{x:Bind GrowthForeground, Mode=OneWay}" />
                                        </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
