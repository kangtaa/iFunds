<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="iFunds.Views.FundDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:iFunds.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource LinearBg}">

    <ScrollViewer Padding="24,48,24,20">
        <StackPanel Spacing="14">

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Click="OnBackClick" Width="34" Height="34" CornerRadius="9"
                        Background="{StaticResource LinearSurface}"
                        BorderBrush="{StaticResource LinearBorder}" BorderThickness="1" Padding="0">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                </Button>
                <StackPanel>
                    <TextBlock x:Name="NameText" FontSize="19" FontWeight="Bold" />
                    <TextBlock x:Name="CodeText" FontSize="12" Opacity="0.5" />
                </StackPanel>
            </StackPanel>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="日涨跌幅" FontSize="12" Opacity="0.55" />
                            <TextBlock x:Name="GrowthText" FontSize="30" FontWeight="Bold" Margin="0,2" />
                            <TextBlock x:Name="EstTimeText" FontSize="11" Opacity="0.5" />
                        </StackPanel>
                        <ctl:Sparkline x:Name="DetailSpark" Grid.Column="1" Height="72" MinWidth="160" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SectionCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="持有收益" FontSize="12" Opacity="0.55" />
                        <TextBlock x:Name="HoldProfitBig" FontSize="24" FontWeight="Bold" Margin="0,3" />
                        <TextBlock x:Name="HoldRateSmall" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="持仓明细" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,0,2,0">
                            <Button Click="OnEditClick" Width="34" Height="34" CornerRadius="8"
                                    MinWidth="0" Padding="0"
                                    Background="{StaticResource LinearSurface}" BorderThickness="0"
                                    ToolTipService.ToolTip="编辑持仓">
                                <FontIcon Glyph="&#xE70F;" FontSize="15" />
                            </Button>
                            <Button Click="OnDeleteClick" Width="34" Height="34" CornerRadius="8"
                                    MinWidth="0" Padding="0"
                                    Background="{StaticResource LinearSurface}" BorderThickness="0"
                                    ToolTipService.ToolTip="移除关注">
                                <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="#E5484D" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                            <TextBlock Text="净值" FontSize="11" Opacity="0.55" />
                            <TextBlock x:Name="NetValueText" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                            <TextBlock Text="成本价" FontSize="11" Opacity="0.55" />
                            <TextBlock x:Name="CostPriceText" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="3">
                            <TextBlock Text="持有份额" FontSize="11" Opacity="0.55" />
                            <TextBlock x:Name="SharesText" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3" Spacing="3">
                            <TextBlock Text="成本金额" FontSize="11" Opacity="0.55" />
                            <TextBlock x:Name="CostAmountText" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                            <TextBlock Text="持有市值" FontSize="11" Opacity="0.55" />
                            <TextBlock x:Name="HoldingAmountText" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <TextBlock Text="当日收益" FontSize="11" Opacity="0.55" />
                            <TextBlock x:Name="EstProfitText" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="3">
                            <TextBlock Text="当日总值" FontSize="11" Opacity="0.55" />
                            <TextBlock x:Name="EstTotalText" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Spacing="3">
                            <TextBlock Text="持有收益率" FontSize="11" Opacity="0.55" />
                            <TextBlock x:Name="HoldRateText" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="涨跌幅提醒" FontSize="14" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="AlertDirBox" Grid.Column="0" SelectedIndex="0" Width="120">
                            <ComboBoxItem Content="涨幅达到" />
                            <ComboBoxItem Content="跌幅达到" />
                        </ComboBox>
                        <NumberBox x:Name="AlertThresholdBox" Grid.Column="1" Value="2" Width="130"
                                   SpinButtonPlacementMode="Inline" SmallChange="0.5"
                                   Minimum="0.1" Maximum="50" />
                        <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Content="添加提醒" Click="OnAddAlertClick"
                                Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl x:Name="AlertList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="9" Padding="12,9" Margin="0,3,0,0"
                                        Background="{StaticResource LinearSurface}">
                                    <Grid>
                                        <TextBlock Text="{Binding DescriptionText}" FontSize="13" VerticalAlignment="Center" />
                                        <Button Click="OnRemoveAlertClick" Tag="{Binding Id}" HorizontalAlignment="Right"
                                                Background="Transparent" BorderThickness="0" Padding="6,2">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#E5484D" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
