<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="iFunds.Views.FundsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:iFunds.Models"
    xmlns:conv="using:iFunds.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource LinearBg}">

    <Page.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </Page.Resources>

    <Grid Padding="24,48,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="基金榜" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="搜索代码或名称，加入自选后会出现在首页" FontSize="12" Opacity="0.5" />
        </StackPanel>

        <AutoSuggestBox Grid.Row="1" Text="{x:Bind ViewModel.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="搜索基金代码或名称…" QueryIcon="Find" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7">
            <RadioButton Content="全部" GroupName="cat" IsChecked="True" Tag="all" Checked="OnCategoryChecked" Style="{StaticResource PeriodToggle}" />
            <RadioButton Content="股票" GroupName="cat" Tag="gp" Checked="OnCategoryChecked" Style="{StaticResource PeriodToggle}" />
            <RadioButton Content="混合" GroupName="cat" Tag="hh" Checked="OnCategoryChecked" Style="{StaticResource PeriodToggle}" />
            <RadioButton Content="债券" GroupName="cat" Tag="zq" Checked="OnCategoryChecked" Style="{StaticResource PeriodToggle}" />
            <RadioButton Content="指数" GroupName="cat" Tag="zs" Checked="OnCategoryChecked" Style="{StaticResource PeriodToggle}" />
            <RadioButton Content="QDII" GroupName="cat" Tag="qdii" Checked="OnCategoryChecked" Style="{StaticResource PeriodToggle}" />
            <RadioButton Content="ETF" GroupName="cat" Tag="etf" Checked="OnCategoryChecked" Style="{StaticResource PeriodToggle}" />
        </StackPanel>

        <Border Grid.Row="3" CornerRadius="11,11,0,0" Padding="16,11"
                Background="{StaticResource LinearSurface}"
                BorderBrush="{StaticResource LinearBorder}" BorderThickness="1,1,1,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.6*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="名称" FontSize="12" Opacity="0.6" />
                <TextBlock Grid.Column="1" Text="净值" FontSize="12" Opacity="0.6" TextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="估算涨跌幅" FontSize="12" Opacity="0.6" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="操作" FontSize="12" Opacity="0.6" TextAlignment="Right" />
            </Grid>
        </Border>

        <ListView Grid.Row="4" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectionMode="None"
                  BorderBrush="{StaticResource LinearBorder}" BorderThickness="1,0,1,1"
                  CornerRadius="0,0,11,11" Background="{StaticResource LinearSurface}"
                  Padding="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Fund">
                    <Border Padding="16,12" BorderBrush="{StaticResource LinearBorder}" BorderThickness="0,0,0,1">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.6*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Code}" FontSize="12" Opacity="0.45"
                                           VerticalAlignment="Center" Width="56" />
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#9FA6E8" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind NetValueOnly, Mode=OneWay}" FontSize="13"
                                       TextAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind GrowthText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{x:Bind GrowthForeground, Mode=OneWay}" />
                            <Button Grid.Column="3" Click="OnWatchClick" Tag="{x:Bind Code}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Padding="6,3"
                                    IsEnabled="{x:Bind Watched, Mode=OneWay, Converter={StaticResource InverseBool}}">
                                <TextBlock Text="{x:Bind WatchButtonText, Mode=OneWay}" FontSize="12" Foreground="#9FA6E8" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing Grid.Row="4" Width="36" Height="36"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
    </Grid>
</Page>
