<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="iFunds.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iFunds"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.15*" MinWidth="100" MaxWidth="160" />
            <ColumnDefinition Width="0.8*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource LinearSurface}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="18,16,18,18">
                <Border Width="28" Height="28" CornerRadius="7" Background="#E5484D">
                    <TextBlock Text="i" Foreground="White" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="iFunds" Foreground="{StaticResource LinearTextPrimary}" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1" Padding="12,4" Spacing="2">
                <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItemStyle}"
                             GroupName="nav" IsChecked="True" Tag="dashboard" Checked="OnNavChecked">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE80F;" FontSize="16" Foreground="#E5484D"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="首页" VerticalAlignment="Center" />
                    </Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItemStyle}" GroupName="nav" Tag="funds" Checked="OnNavChecked">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8FD;" FontSize="16" Foreground="#E5484D"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="基金" VerticalAlignment="Center" />
                    </Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItemStyle}" GroupName="nav" Tag="market" Checked="OnNavChecked">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8D5;" FontSize="16" Foreground="#5E6AD2"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="行情" VerticalAlignment="Center" />
                    </Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItemStyle}" GroupName="nav" Tag="holdings" Checked="OnNavChecked">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7C1;" FontSize="16" Foreground="#5E6AD2"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="持仓" VerticalAlignment="Center" />
                    </Grid>
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="2" Padding="12,4,12,18" Spacing="2">
                <Border Height="1" Background="{StaticResource LinearBorder}" Margin="6,0,6,8" />
                <RadioButton Style="{StaticResource NavItemStyle}" GroupName="nav" Tag="analysis" Checked="OnNavChecked">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE9D2;" FontSize="16" Foreground="#6E7178"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="分析" VerticalAlignment="Center" />
                    </Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItemStyle}" GroupName="nav" Tag="account" Checked="OnNavChecked">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="16" Foreground="#6E7178"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="账户" VerticalAlignment="Center" />
                    </Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItemStyle}" GroupName="nav" Tag="settings" Checked="OnNavChecked">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE713;" FontSize="16" Foreground="#6E7178"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="设置" VerticalAlignment="Center" />
                    </Grid>
                </RadioButton>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="{StaticResource LinearBg}">
            <Frame x:Name="ContentFrame" />
            <!-- 顶部拖动条覆盖在内容上方，仅右侧留给系统按钮 -->
            <Border x:Name="TitleBarDragArea" Height="40" VerticalAlignment="Top"
                    Background="Transparent" />
        </Grid>

        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="iFunds 基金净值"
                        IconSource="ms-appx:///Assets/iFunds.ico">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="MenuShow" Text="显示主窗口" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="MenuExit" Text="退出" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
